# Local model (LM Studio). ChatOpenAI uses the gateway, not this URL directly.
MODEL_NAME=qwen/qwen3.8-27b
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# agentgateway (LLM + MCP)
AGENTGATEWAY_URL=http://127.0.0.1:8080
AGENTGATEWAY_VERSION=1.4.1

# OTLP collector (Jaeger all-in-one). Demo does not start it.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# LangGraph -32602 repair attempts after the first illegal call
REPAIR_BUDGET=3

# Dummy key for OpenAI-compatible local endpoints
OPENAI_API_KEY=lm-studio
